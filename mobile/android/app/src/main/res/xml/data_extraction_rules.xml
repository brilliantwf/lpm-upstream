<?xml version="1.0" encoding="utf-8"?>
<!--
  Pairing credentials are encrypted with an Android Keystore key, which never
  leaves the device, so copied data could not be decrypted on a new phone and
  would leave paired Macs unusable. Nothing is copied; a new phone pairs again.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
