<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower; see data_extraction_rules.xml for why nothing is copied. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
